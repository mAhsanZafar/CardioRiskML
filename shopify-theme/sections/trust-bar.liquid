{% comment %}
  ELA Professional – Trust Bar Section
  Displays a horizontal bar with trust/feature icons.
  Fully editable via the Shopify Theme Editor.
{% endcomment %}

<div class="ela-trust-bar">
  <div class="ela-trust-bar__inner">
    {%- for block in section.blocks -%}
      <div class="ela-trust-bar__item" {{ block.shopify_attributes }}>
        {%- if block.settings.icon == 'leaf' -%}
          <svg class="ela-trust-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 4-8 4s-1 0-1 0C9 7 6 10 5 13s0 7 4 8.5C7 16 11 12 17 8z"/>
          </svg>
        {%- elsif block.settings.icon == 'heart' -%}
          <svg class="ela-trust-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.27 2 8.5 2 5.41 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.08C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.41 22 8.5c0 3.77-3.4 6.86-8.55 11.53L12 21.35z"/>
          </svg>
        {%- elsif block.settings.icon == 'star' -%}
          <svg class="ela-trust-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
          </svg>
        {%- elsif block.settings.icon == 'truck' -%}
          <svg class="ela-trust-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"/>
          </svg>
        {%- else -%}
          <svg class="ela-trust-bar__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
          </svg>
        {%- endif -%}
        <span>{{ block.settings.label | escape }}</span>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "ELA Trust Bar",
  "tag": "div",
  "class": "ela-section-trust-bar",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check",  "label": "Checkmark" },
            { "value": "leaf",   "label": "Leaf / Natural" },
            { "value": "heart",  "label": "Heart / Cruelty-Free" },
            { "value": "star",   "label": "Star / Professional" },
            { "value": "truck",  "label": "Truck / Shipping" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Cruelty-Free"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "ELA Trust Bar",
      "category": "ELA Professional",
      "blocks": [
        { "type": "trust_item", "settings": { "icon": "leaf",  "label": "Sulfate-Free" } },
        { "type": "trust_item", "settings": { "icon": "heart", "label": "Cruelty-Free" } },
        { "type": "trust_item", "settings": { "icon": "star",  "label": "Professional Grade" } },
        { "type": "trust_item", "settings": { "icon": "truck", "label": "Free Shipping on Orders $50+" } }
      ]
    }
  ]
}
{% endschema %}

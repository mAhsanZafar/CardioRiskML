{% comment %}
  ELA Professional – Featured Products Grid Section
  Displays up to 4 products in a responsive grid.
  Products are selected via the Theme Editor.
{% endcomment %}

<section class="ela-products-section">
  <div class="ela-section-header">
    <h2 class="ela-section-title">{{ section.settings.title | default: 'Featured Products' }}</h2>
    {%- if section.settings.subtitle != blank -%}
      <p class="ela-section-sub">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}
  </div>

  <div class="ela-products-grid">
    {%- for block in section.blocks -%}
      {%- assign product = block.settings.product -%}

      {%- if product != blank -%}
        <div class="ela-product-card" {{ block.shopify_attributes }}>
          <a href="{{ product.url }}" class="ela-product-card__image-wrap" aria-label="{{ product.title | escape }}">
            {%- if product.featured_image -%}
              <img
                class="ela-product-card__image"
                src="{{ product.featured_image | image_url: width: 600 }}"
                srcset="
                  {{ product.featured_image | image_url: width: 300 }} 300w,
                  {{ product.featured_image | image_url: width: 600 }} 600w,
                  {{ product.featured_image | image_url: width: 900 }} 900w
                "
                sizes="(max-width: 768px) 50vw, 25vw"
                alt="{{ product.featured_image.alt | escape | default: product.title | escape }}"
                loading="lazy"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'ela-product-card__image' }}
            {%- endif -%}

            {%- if product.available == false -%}
              <span class="ela-product-card__badge">Sold Out</span>
            {%- elsif block.settings.badge != blank -%}
              <span class="ela-product-card__badge">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
          </a>

          <div class="ela-product-card__info">
            {%- if product.type != blank -%}
              <p class="ela-product-card__collection">{{ product.type | escape }}</p>
            {%- endif -%}

            <a href="{{ product.url }}">
              <h3 class="ela-product-card__title">{{ product.title | escape }}</h3>
            </a>

            <p class="ela-product-card__price">
              {%- if product.compare_at_price > product.price -%}
                <s style="color:#999;margin-right:6px;">{{ product.compare_at_price | money }}</s>
              {%- endif -%}
              {{ product.price | money }}
            </p>

            <a
              href="{{ product.url }}"
              class="ela-btn ela-product-card__btn"
              aria-label="Shop {{ product.title | escape }}"
            >
              {{ block.settings.button_label | default: 'Shop Now' | escape }}
            </a>
          </div>
        </div>
      {%- else -%}
        {%- comment -%} Placeholder block for Theme Editor {%- endcomment -%}
        <div class="ela-product-card" {{ block.shopify_attributes }}>
          <div class="ela-product-card__image-wrap" style="background:#f0f0f0;"></div>
          <div class="ela-product-card__info">
            <p class="ela-product-card__collection">Collection</p>
            <h3 class="ela-product-card__title">Product Name</h3>
            <p class="ela-product-card__price">$0.00</p>
            <span class="ela-btn ela-product-card__btn">Shop Now</span>
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.show_view_all -%}
    <div class="ela-text-center" style="margin-top:48px;">
      <a href="{{ section.settings.view_all_url | default: '/collections/all' }}" class="ela-btn ela-btn--outline">
        {{ section.settings.view_all_label | default: 'View All Products' | escape }}
      </a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "ELA Featured Products",
  "tag": "section",
  "class": "ela-section-featured-products",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Science-backed formulas for every skin and hair type."
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View All' button",
      "default": true
    },
    {
      "type": "url",
      "id": "view_all_url",
      "label": "'View All' URL"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "'View All' button label",
      "default": "View All Products"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge text (optional)",
          "info": "E.g. 'Bestseller' or 'New'"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop Now"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "ELA Featured Products",
      "category": "ELA Professional",
      "blocks": [
        { "type": "product", "settings": { "badge": "Bestseller", "button_label": "Shop Now" } },
        { "type": "product", "settings": { "badge": "",           "button_label": "Shop Now" } },
        { "type": "product", "settings": { "badge": "New",        "button_label": "Shop Now" } },
        { "type": "product", "settings": { "badge": "",           "button_label": "Shop Now" } }
      ]
    }
  ]
}
{% endschema %}
